# === ArcTools ===
BOT_TOKEN=123456:ABC...                 # token z @BotFather
MASTER_KEY=                             # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ADMIN_IDS=8351095206,8357645116

# --- ARC mainnet ---
# Infura wymaga klucza projektu (bez niego: "invalid project id"):
#   https://arc-mainnet.infura.io/v3/<TWOJ_INFURA_KEY>
# QuickNode: pelny URL z panelu, np. https://tiniest-newest-arrow.arc-mainnet.quiknode.pro/<TOKEN>/
ARC_RPC_URLS=https://arc-mainnet.infura.io/v3/TWOJ_KEY,https://twoj-endpoint.arc-mainnet.quiknode.pro/TOKEN/
ARC_WSS_URL=                            # opcjonalnie wss:// dla eventow (bez tego polling)
ARC_CHAIN_ID=5042
ARC_EXPLORER=https://arc-scan.org

# USDC ERC-20 facade (6 decimals, widok na natywne USDC) - pooly V3 paruja z nim:
WRAPPED_USDC=0x3600000000000000000000000000000000000000

# --- Uniswap V3 na ARC mainnet (kanoniczny) ---
UNIV3_FACTORY=0xf0db7b58379503491d857dB50AC9ece64c653918
UNIV3_ROUTER=0x53bf6b0684ec7ef91e1387da3d1a1769bc5a6f77
UNIV3_QUOTER=0x7dfd4f31be6814d2906bde155c3e1b146eac1468

# --- Feed / kanal publiczny ---
FEED_CHANNEL_ID=                        # np. -100123456789 (opcjonalnie)

# --- DB ---
DATABASE_URL=sqlite+aiosqlite:///arctools.db   # Railway: postgresql+asyncpg://...

# --- CCTP v2 bridge (source chains) ---
ETH_RPC=
BASE_RPC=
ARB_RPC=
ARC_CCTP_DOMAIN=                        # domain ID ARC (Circle publikuje przy mainnecie)
IRIS_API=https://iris-api.circle.com

# --- Sniper defaults ---
